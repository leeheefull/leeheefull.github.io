---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const base = import.meta.env.BASE_URL;
---

<Base title={`${project.data.title} | 이희찬`} description={project.data.summary}>
  <nav class="back">
    <a href={`${base}/`}>← 돌아가기</a>
  </nav>

  <header class="project-header">
    <p class="company">{project.data.company}</p>
    <h1>{project.data.title}</h1>
    {project.data.period && <p class="period">{project.data.period}</p>}
    {
      project.data.tech.length > 0 && (
        <ul class="tech">
          {project.data.tech.map((t) => (
            <li class="chip">{t}</li>
          ))}
        </ul>
      )
    }
  </header>

  <article class="content">
    <Content />
  </article>
</Base>

<style>
  .back {
    margin-bottom: 32px;
    font-size: 0.95rem;
  }

  .project-header .company {
    font-weight: 600;
    color: var(--accent);
    font-size: 0.95rem;
  }

  .project-header h1 {
    margin-top: 6px;
    font-size: 1.8rem;
  }

  .project-header .period {
    margin-top: 8px;
    color: var(--text-soft);
    font-size: 0.9rem;
  }

  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin-top: 16px;
    list-style: none;
  }

  .content {
    margin-top: 40px;
  }

  .content :global(h2) {
    font-size: 1.25rem;
    margin: 32px 0 12px;
  }

  .content :global(h3) {
    font-size: 1.05rem;
    margin: 24px 0 10px;
  }

  .content :global(p) {
    margin: 10px 0;
  }

  .content :global(ul),
  .content :global(ol) {
    padding-left: 22px;
    margin: 10px 0;
  }

  .content :global(li) {
    margin: 6px 0;
  }

  .content :global(code) {
    background: var(--bg-soft);
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 1px 5px;
    font-size: 0.85em;
  }
</style>
