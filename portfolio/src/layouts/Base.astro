---
import '../styles/global.css';
import { PORTFOLIO, RESUME } from '../data/links';

interface Props {
  title: string;
  description?: string;
  /** 지금 보고 있는 쪽. 우측 상단에는 반대쪽으로 가는 링크를 단다 */
  site?: 'portfolio' | 'resume';
}

const { title, description = '백엔드 개발자 이희찬의 포트폴리오', site = 'portfolio' } = Astro.props;
const other = site === 'portfolio' ? { href: `${RESUME}/`, label: '이력서 보기' } : { href: `${PORTFOLIO}/`, label: '포트폴리오 보기' };
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${PORTFOLIO}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${PORTFOLIO}/apple-touch-icon.png`} />
    {site === 'portfolio' && <link rel="manifest" href={`${PORTFOLIO}/site.webmanifest`} />}
    <meta name="theme-color" content="#0969da" />
  </head>
  <body>
    <main>
      <nav class="topbar">
        <div class="topbar-left"><slot name="topbar-left" /></div>
        <a class="switch" href={other.href}>{other.label} →</a>
      </nav>
      <slot />
    </main>
  </body>
</html>

<style>
  .topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-bottom: 32px;
    font-size: 0.95rem;
  }

  .switch {
    padding: 6px 14px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-soft);
    font-size: 0.85rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .switch:hover {
    border-color: var(--accent);
    text-decoration: none;
  }

  @media print {
    .topbar {
      display: none;
    }
  }
</style>
